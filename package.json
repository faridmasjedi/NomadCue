{
  "name": "nomadcue",
  "productName": "NomadCue",
  "version": "0.1.0",
  "description": "Free, open-source, cross-platform show control: audio, video, lighting, OSC, MIDI \u2014 every feature unlocked.",
  "main": "src/main/main.js",
  "author": "Farid Masjedi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "NQ_SMOKE=1 electron .",
    "docs:gifs": "electron scripts/docs-gifs/record.js",
    "test": "node --test test/*.test.mjs",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "app.nomadcue",
    "productName": "NomadCue",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "nomadcue",
        "name": "NomadCue Workspace",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "maintainer": "Farid Masjedi <faridmasjedi@users.noreply.github.com>"
    },
    "directories": {
      "buildResources": "build"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/faridmasjedi/NomadCue.git"
  }
}
